APP_DEBUG = false
DEFAULT_LANG = zh-cn

# Public HTTPS origin of the management console. Leave blank only when PHP
# receives the original Host and scheme directly (for example local dev).
APP_ORIGIN =

DB_DRIVER = mysql
DB_TYPE = mysql
# For a local Baota/MySQL account, use the host granted to that account. It is
# often localhost; use 127.0.0.1 only when the account is authorized for it.
DB_HOST = localhost
DB_PORT = 3306
DB_NAME = jingyun
DB_USER =
DB_PASS =
DB_CHARSET = utf8mb4
DB_PREFIX =

# Required for provider-credential encryption and API-key generation. For a
# manual installation, generate a distinct key with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# install.php generates a new random key automatically for every installation.
CREDENTIAL_ENCRYPTION_KEY =
CREDENTIAL_ENCRYPTION_KEY_VERSION = v1

# Production-safe defaults. For local plain HTTP only, set secure to false and
# use a name without the reserved __Host- prefix (for example jingyun_session).
SESSION_SECURE_COOKIE = true
SESSION_NAME = __Host-jingyun_session
SESSION_EXPIRE = 7200
SESSION_DATABASE_TABLE = sessions
